# Server-only inputs. Secret VALUES are never environment variables.
MTLS_ENROLL_LISTEN=127.0.0.1:19101
MTLS_ENROLL_GATEWAY_SOCKET=/run/codeasier-router-enroll/gateway.sock
MTLS_ENROLL_STATE_DIR=/var/lib/codeasier-router-enroll
MTLS_ENROLL_JOURNAL_DIR=/srv/codeasier-enroll-journal
MTLS_ENROLL_TOKEN_KEY_FILE=/etc/codeasier-router-enroll/token-key
MTLS_ENROLL_CLIENT_ID=REPLACE_WITH_DEDICATED_APP_ID
MTLS_ENROLL_CLIENT_SECRET_FILE=/etc/codeasier-router-enroll/gitcode-client-secret
GITCODE_ORG_PATH=msinsight-org
MTLS_ENROLL_ORG_ID=REPLACE_WITH_VERIFIED_STABLE_ORG_ID
MTLS_ENROLL_ISSUER_CERT_FILE=/etc/codeasier-router-enroll/issuing-cert.pem
MTLS_ENROLL_ISSUER_KEY_FILE=/etc/codeasier-router-enroll/issuing-key.pem
MTLS_ENROLL_ROOT_CA_FILE=/etc/codeasier-router-enroll/root-cert.pem
MTLS_ENROLL_ROOT_CRL_FILE=/etc/codeasier-router-enroll/root-crl.pem
MTLS_ENROLL_GATEWAYS_FILE=/etc/codeasier-router-enroll/gateways.json
