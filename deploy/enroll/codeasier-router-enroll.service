[Unit]
Description=CodeasierRouter personal certificate enrollment master
After=network-online.target
Wants=network-online.target
RequiresMountsFor=/srv/codeasier-enroll-journal
AssertPathIsMountPoint=/srv/codeasier-enroll-journal

[Service]
Type=simple
User=codeasier-enroll
Group=codeasier-enroll
UMask=0077
EnvironmentFile=/etc/codeasier-router-enroll/enroll.env
ExecStart=/usr/local/libexec/codeasier-router-enroll
Restart=on-failure
RestartSec=5s
TimeoutStopSec=10s
StateDirectory=codeasier-router-enroll
StateDirectoryMode=0700
RuntimeDirectory=codeasier-router-enroll
RuntimeDirectoryMode=0750
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/codeasier-router-enroll /srv/codeasier-enroll-journal
LimitCORE=0

[Install]
WantedBy=multi-user.target
